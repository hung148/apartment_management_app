rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // v2 documents are served through role-specific callable projections.
    // A missing version preserves the legacy app until coordinated migration.
    function legacyOrganization(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('accessVersion', 1) == 1 &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.get('mergedInto', null) == null;
    }
    function member(orgId) {
      return signedIn() && legacyOrganization(orgId) && bindingAllows(orgId) && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.status == 'active';
    }
    function bindingAllows(orgId) {
      return !exists(/databases/$(database)/documents/accountOrganizations/$(request.auth.uid)) ||
        (get(/databases/$(database)/documents/accountOrganizations/$(request.auth.uid)).data.state == 'bound' &&
         get(/databases/$(database)/documents/accountOrganizations/$(request.auth.uid)).data.organizationId == orgId);
    }
    function admin(orgId) {
      return member(orgId) && get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.role == 'admin';
    }
    function legacyOwner(orgId) {
      return admin(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)).data.get(
        'ownerTransferredTo', get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy) == request.auth.uid;
    }
    function sameOrganization() {
      return request.resource.data.organizationId == resource.data.organizationId;
    }
    function bookingPayment(data) {
      return data.get('bookingId', null) != null;
    }
    // AI quotas, drafts, provider requests and paid entitlements are server-only.
    match /aiUsage/{id} { allow read, write: if false; }
    match /aiRequests/{id} { allow read, write: if false; }
    match /aiDrafts/{id} { allow read, write: if false; }
    match /aiEntitlements/{id} { allow read, write: if false; }
    match /owners/{ownerId} {
      allow read, write: if signedIn() && request.auth.uid == ownerId;
    }
    match /organizations/{orgId} {
      allow read: if member(orgId);
      // Both legacy and v2 creation use the callable account-policy transaction.
      allow create: if false;
      allow update: if admin(orgId) && request.resource.data.createdBy == resource.data.createdBy &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessVersion', 'companyId', 'governanceRevision', 'ownerTransferredTo', 'ownerTransferredAt', 'closedAt', 'closedBy', 'purgeAfter', 'mergedInto', 'mergedFrom', 'mergedAt']);
      allow delete: if legacyOwner(orgId);
    }
    match /invite_codes/{code} {
      allow get: if signedIn() && legacyOrganization(resource.data.orgId);
      // Codes can be looked up, but cannot be enumerated.
      allow list: if false;
      allow create: if signedIn() && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.get('accessVersion', 1) == 1 && (
        admin(request.resource.data.orgId) ||
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid
      );
      allow delete: if admin(resource.data.orgId);
    }
    match /memberships/{membershipId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/memberships/$(membershipId)) ||
        resource.data.ownerId == request.auth.uid || admin(resource.data.organizationId));
      allow list: if signedIn() && (resource.data.ownerId == request.auth.uid || admin(resource.data.organizationId));
      // Membership attachment is server-owned in both versions. A legacy
      // creator must not recreate admin access after an ownership transfer.
      allow create: if false;
      allow update: if signedIn() && legacyOrganization(resource.data.organizationId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessVersion', 'buildingScope', 'buildingIds', 'permissionOverrides', 'staffId', 'roleGrants', 'roleRevision', 'roleName', 'employerShareId', 'ownershipControls', 'ownershipAgreementId', 'employerApprovedBy', 'employerPrimary']) &&
        sameOrganization() && request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.role in ['admin', 'member'] && (
        admin(resource.data.organizationId) ||
        (resource.data.ownerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email']))
      );
      allow delete: if signedIn() && legacyOrganization(resource.data.organizationId) && (resource.data.ownerId == request.auth.uid || admin(resource.data.organizationId));
    }
    match /buildings/{buildingId} {
      allow read: if member(resource.data.organizationId);
      allow create: if member(request.resource.data.organizationId);
      allow update: if member(resource.data.organizationId) && sameOrganization();
      allow delete: if member(resource.data.organizationId);
    }
    match /rooms/{roomId} {
      allow read: if member(resource.data.organizationId);
      allow create: if member(request.resource.data.organizationId) && !request.resource.data.keys().hasAny(['bookingRevision']);
      allow update: if member(resource.data.organizationId) && sameOrganization() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bookingRevision']);
      allow delete: if member(resource.data.organizationId);
    }
    match /bookings/{bookingId} {
      allow read: if member(resource.data.organizationId);
      // Admin SDK in authenticated callable functions owns all booking writes.
      allow write: if false;
    }
    match /payments/{paymentId} {
      allow read: if member(resource.data.organizationId);
      allow create: if member(request.resource.data.organizationId) && !bookingPayment(request.resource.data) && !paymentId.matches('^booking_.*');
      allow update: if member(resource.data.organizationId) && sameOrganization() &&
        !bookingPayment(resource.data) && !bookingPayment(request.resource.data) && !paymentId.matches('^booking_.*');
      allow delete: if member(resource.data.organizationId) && !bookingPayment(resource.data) && !paymentId.matches('^booking_.*');
    }
    match /tenants/{tenantId} {
      allow read: if member(resource.data.organizationId);
      // Lease creation and occupancy changes must acquire the room lock on the server.
      allow create: if false;
      allow update: if member(resource.data.organizationId) && sameOrganization() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roomId', 'buildingId', 'status', 'moveInDate', 'moveOutDate', 'currency']);
      allow delete: if admin(resource.data.organizationId);
    }
  }
}
