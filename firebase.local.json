{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test",
        "staging_index.js",
        "security_scan.js",
        "security_pub_audit.js",
        "team_inventory.js",
        "restore_recorded_creators.js",
        "delete_orphan_organizations.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9199 },
    "functions": { "port": 5101 },
    "firestore": { "port": 8180 },
    "ui": { "enabled": true, "port": 4100 },
    "hub": { "port": 4500 },
    "logging": { "port": 4600 },
    "eventarc": { "port": 9399 },
    "singleProjectMode": true
  }
}
