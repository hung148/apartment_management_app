{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "apartment-management-app-776b9",
          "appId": "1:595994118808:android:f099dea390668bee271eed",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "apartment-management-app-776b9",
          "configurations": {
            "android": "1:595994118808:android:f099dea390668bee271eed",
            "ios": "1:595994118808:ios:bf9f0ea4d4a26a69271eed",
            "macos": "1:595994118808:ios:bf9f0ea4d4a26a69271eed",
            "web": "1:595994118808:web:4cbc3b57688c6ef7271eed",
            "windows": "1:595994118808:web:5af7c088a203ac12271eed"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|json|mjs|wasm|otf|ttf|woff|woff2|png|jpg|jpeg|webp|svg|bin|frag)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test",
        "staging_index.js",
        "security_scan.js",
        "security_pub_audit.js",
        "team_inventory.js",
        "restore_recorded_creators.js",
        "delete_orphan_organizations.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
